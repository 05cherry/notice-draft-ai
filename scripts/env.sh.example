# 로컬 테스트용 환경변수 (bash / Git Bash)
# ─────────────────────────────────────────────────────────────────────────────
# 사용법 (저장소 루트에서):
#   1) 이 파일을 scripts/env.sh 로 복사   cp scripts/env.sh.example scripts/env.sh
#   2) 아래 값을 채운다 (비밀값)
#   3) 수집은 래퍼로 한 줄:                scripts/collect.sh --incremental
#      (직접 쓰려면)                       source scripts/env.sh 후 py -m notice_ai.cli ...
#
# scripts/env.sh 는 .gitignore 에 있어 커밋되지 않는다. 이 .example 만 커밋한다.
# ─────────────────────────────────────────────────────────────────────────────

# --- 공통(검색·색인·CLI) ---
export PYTHONPATH=src
export PYTHONIOENCODING=utf-8

# --- OpenSearch (수집·검색 필수) ---
export OPENSEARCH_ENDPOINT='https://search-....ap-northeast-2.es.amazonaws.com'
export OPENSEARCH_USER='admin'
export OPENSEARCH_PASSWORD='여기에_비밀번호'

# --- 인덱스 대상 선택 ---
# 기본(아래 두 줄 주석 유지): 별칭 notices_live 가 가리키는 실인덱스에 색인된다.
# 따로 가르고 싶을 때만 주석을 풀어 테스트 전용 인덱스로 보낸다.
#   (처음 한 번은  py -m notice_ai.cli setup-index  로 그 인덱스를 만든다)
# export NOTICE_ALIAS=''                 # 별칭 무시 → NOTICE_INDEX 사용
# export NOTICE_INDEX='notices_test'     # 테스트 전용 인덱스

# --- LLM (초안 생성·맞춤법에만 필요. 수집만 할 거면 없어도 됨) ---
export LLM_PROVIDER='openai'            # 또는 local / company
export OPENAI_API_KEY='sk-...'
# export LLM_TIMEOUT=90
# export LLM_MAX_RETRIES=1

# --- Bedrock 임베딩 (collect 끝의 자동 임베딩·벡터 검색에 필요) ---
# 없으면 수집은 되고 임베딩만 건너뛴다(나중에 `py -m notice_ai.cli embed`).
export AWS_REGION='ap-northeast-2'
# export AWS_ACCESS_KEY_ID='...'
# export AWS_SECRET_ACCESS_KEY='...'

# --- API 접근 토큰 (공개 배포 시 auth.py. 로컬 수집엔 불필요) ---
# 있으면 /search·/draft·/admin 호출에 이 토큰이 필요하다. 없으면 검사 없음(로컬 그대로).
# export API_TOKEN='...'

echo "notice-draft-ai 환경변수 로드 완료 (OpenSearch=$OPENSEARCH_ENDPOINT, LLM=$LLM_PROVIDER)"
