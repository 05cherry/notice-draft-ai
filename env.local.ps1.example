# 로컬 테스트용 환경변수 (PowerShell)
# ─────────────────────────────────────────────────────────────────────────────
# 사용법:
#   1) 이 파일을 env.local.ps1 로 복사   Copy-Item env.local.ps1.example env.local.ps1
#   2) 아래 값을 채운다 (비밀값)
#   3) 새 터미널마다 한 번 불러온다       . .\env.local.ps1     (앞의 점+공백 = dot-source)
#
# env.local.ps1 은 .gitignore 에 있어 커밋되지 않는다. 이 .example 만 커밋한다.
# 실행 정책에 막히면:  Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
# ─────────────────────────────────────────────────────────────────────────────

# --- 공통(검색·색인·CLI) ---
$env:PYTHONPATH      = "src"
$env:PYTHONIOENCODING = "utf-8"          # Windows 콘솔 한글 깨짐 방지

# --- OpenSearch (수집·검색 필수) ---
$env:OPENSEARCH_ENDPOINT = "https://search-....ap-northeast-2.es.amazonaws.com"
$env:OPENSEARCH_USER     = "admin"
$env:OPENSEARCH_PASSWORD = "여기에_비밀번호"

# --- 인덱스 대상 선택 ---
# 기본(아래 두 줄 주석 유지): 별칭 notices_live 가 가리키는 "운영 실인덱스"에 색인된다.
# 운영을 건드리지 않고 테스트하려면 두 줄의 주석을 풀어 테스트 전용 인덱스로 보낸다.
#   (처음 한 번은  py -m notice_ai.cli setup-index  로 그 인덱스를 만든다)
# $env:NOTICE_ALIAS = ""                 # 별칭 무시 → NOTICE_INDEX 사용
# $env:NOTICE_INDEX = "notices_test"     # 테스트 전용 인덱스

# --- LLM (초안 생성·맞춤법에만 필요. 수집만 할 거면 없어도 됨) ---
$env:LLM_PROVIDER  = "openai"            # 또는 local / company
$env:OPENAI_API_KEY = "sk-..."
# $env:LLM_TIMEOUT    = "90"
# $env:LLM_MAX_RETRIES = "1"

# --- Bedrock 임베딩 (collect 끝의 자동 임베딩·벡터 검색에만 필요) ---
# 없으면 수집은 되고 임베딩만 건너뛴다(나중에 `py -m notice_ai.cli embed`). 테스트는 --no-embed 권장.
$env:AWS_REGION = "ap-northeast-2"
# $env:AWS_ACCESS_KEY_ID     = "..."
# $env:AWS_SECRET_ACCESS_KEY = "..."

Write-Host "notice-draft-ai 환경변수 로드 완료 (OpenSearch=$env:OPENSEARCH_ENDPOINT, LLM=$env:LLM_PROVIDER)"
